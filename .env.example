# Configure secrets through Sites environment variables. Do not commit or paste keys into chat.
# Prefer a restricted rk_test_ / rk_live_ key with Checkout Sessions read and write access.
# STRIPE_MODE must match the key; sandbox payments never become real orders.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
CHECKOUT_PUBLIC_READY=false
